# ---- Data (never commit raw or cached pipeline cache) ----
# Leading slash = repo-root only. Do not ignore web/public/data/ — that
# snapshot is what Vercel serves and must be committed.
/data/
*.parquet
*.duckdb
*.duckdb.wal
*.csv
!docs/**/*.csv          # allow small example CSVs in docs if ever needed

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# ---- Node / frontend (Phase 3+) ----
node_modules/
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-error.log*

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
*.swp

# Cursor: keep .cursor/rules (they're versioned), ignore local Cursor state
.cursor/*
!.cursor/rules/

# Matplotlib cache used when HOME isn't writable
.mplconfig/

# Salesforce CLI state (work tooling, unrelated to this project)
.sf/
.sfdx/

# SeleniumBase / chromedriver leftovers from earlier FBref fetching
notebooks/downloaded_files/
